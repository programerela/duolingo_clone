{
  "expo": {
    "name": "LingoCat",
    "slug": "lingocat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/lingocat-icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/lingocat-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/lingocat-adaptive.png",
        "backgroundColor": "#58CC02"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lingocat.app"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#131F24",
          "image": "./assets/images/lingocat-splash.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
