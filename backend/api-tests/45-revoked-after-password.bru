meta {
  name: 45 Refresh Revoked After Password Change
  type: http
  seq: 45
}
post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: json
  auth: none
}
body:json {
  {"refreshToken":"{{passwordChangeRefreshToken}}"}
}
tests {
  test("old refresh token is revoked by password change", function () { expect(res.status).to.equal(401); });
}
