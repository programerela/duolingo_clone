meta {
  name: 19 Check Correct Answer
  type: http
  seq: 19
}
post {
  url: {{baseUrl}}/api/v1/lessons/{{lessonId}}/exercises/{{ex1Id}}/check
  body: json
  auth: bearer
}
auth:bearer {
  token: {{accessToken}}
}
body:json {
  {"answer":"  hello  "}
}
tests {
  test("backend checks normalized correct answer", function () { expect(res.status).to.equal(200); expect(res.body.correct).to.equal(true); expect(res.body.correctAnswer).to.equal("Hello"); });
}
