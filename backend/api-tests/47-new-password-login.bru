meta {
  name: 47 New Password Login
  type: http
  seq: 47
}
post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}
body:json {
  {"emailOrUsername":"{{updatedUsername}}","password":"password456"}
}
script:post-response {
  if (res.status===200) { bru.setEnvVar("accessToken",res.body.accessToken); bru.setEnvVar("refreshToken",res.body.refreshToken); }
}
tests {
  test("new password works", function () { expect(res.status).to.equal(200); });
}
