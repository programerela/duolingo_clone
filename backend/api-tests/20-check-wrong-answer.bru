meta {
  name: 20 Check Wrong Answer
  type: http
  seq: 20
}
post {
  url: {{baseUrl}}/api/v1/lessons/{{lessonId}}/exercises/{{ex2Id}}/check
  body: json
  auth: bearer
}
auth:bearer {
  token: {{accessToken}}
}
body:json {
  {"answer":"Wrong answer"}
}
tests {
  test("wrong answer returns feedback", function () { expect(res.status).to.equal(200); expect(res.body.correct).to.equal(false); expect(res.body.correctAnswer).to.equal("Good morning"); });
}
