meta {
  name: 05 Duplicate Username Case Insensitive
  type: http
  seq: 5
}
post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}
script:pre-request {
  bru.setEnvVar("upperUsername", bru.getEnvVar("testUsername").toUpperCase());
  bru.setEnvVar("caseUsernameEmail", `case_${Date.now()}@example.com`);
}
body:json {
  {"email":"{{caseUsernameEmail}}","username":"{{upperUsername}}","password":"password123"}
}
tests {
  test("username uniqueness is case insensitive", function () { expect(res.status).to.equal(409); });
}
