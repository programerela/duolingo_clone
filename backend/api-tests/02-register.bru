meta {
  name: 02 Register Primary User
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}
script:pre-request {
  const suffix = Date.now().toString();
  bru.setEnvVar("testEmail", `bruno_${suffix}@example.com`);
  bru.setEnvVar("testUsername", `bruno_${suffix}`);
  bru.setEnvVar("updatedUsername", `bruno_updated_${suffix}`);
  bru.setEnvVar("takenUsername", `bruno_taken_${suffix}`);
}
body:json {
  {"email":"{{testEmail}}","username":"{{testUsername}}","displayName":"Bruno Test","password":"password123","timezone":"Europe/Belgrade"}
}
script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("accessToken", res.body.accessToken);
    bru.setEnvVar("refreshToken", res.body.refreshToken);
  }
}
tests {
  test("register returns 201 and camelCase user", function () {
    expect(res.status).to.equal(201);
    expect(res.body.user.displayName).to.equal("Bruno Test");
    expect(res.body.accessToken).to.be.a("string");
    expect(res.body.refreshToken).to.be.a("string");
  });
}
