meta {
  name: 48 Logout
  type: http
  seq: 48
}
post {
  url: {{baseUrl}}/api/v1/auth/logout
  body: json
  auth: bearer
}
auth:bearer {
  token: {{accessToken}}
}
body:json {
  {"refreshToken":"{{refreshToken}}"}
}
tests {
  test("logout revokes refresh token", function () { expect(res.status).to.equal(200); });
}
