meta {
  name: 44 Change Password
  type: http
  seq: 44
}
patch {
  url: {{baseUrl}}/api/v1/profile/password
  body: json
  auth: bearer
}
auth:bearer {
  token: {{accessToken}}
}
script:pre-request {
  bru.setEnvVar("passwordChangeRefreshToken", bru.getEnvVar("refreshToken"));
}
body:json {
  {"currentPassword":"password123","newPassword":"password456"}
}
tests {
  test("password changes and refresh sessions are revoked", function () { expect(res.status).to.equal(200); });
}
