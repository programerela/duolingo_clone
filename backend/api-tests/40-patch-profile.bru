meta {
  name: 40 Patch Profile
  type: http
  seq: 40
}
patch {
  url: {{baseUrl}}/api/v1/profile
  body: json
  auth: bearer
}
auth:bearer {
  token: {{accessToken}}
}
body:json {
  {"displayName":"Updated Bruno","username":"{{updatedUsername}}","timezone":"Europe/Paris","avatarKey":"cat_blue"}
}
tests {
  test("profile fields update", function () { expect(res.status).to.equal(200); expect(res.body.profile.username).to.equal(bru.getEnvVar("updatedUsername")); expect(res.body.profile.displayName).to.equal("Updated Bruno"); expect(res.body.profile.avatarKey).to.equal("cat_blue"); });
}
