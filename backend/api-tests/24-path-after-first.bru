meta {
  name: 24 Path After First Lesson
  type: http
  seq: 24
}
get {
  url: {{baseUrl}}/api/v1/courses/{{spanishCourseId}}/path
  body: none
  auth: bearer
}
auth:bearer {
  token: {{accessToken}}
}
tests {
  test("completion persists and next lesson unlocks", function () {
    const lessons = res.body.sections.flatMap(s => s.units.flatMap(u => u.lessons));
    expect(lessons[0].status).to.equal("COMPLETED");
    expect(lessons[0].completionCount).to.equal(1);
    expect(lessons[0].bestAccuracy).to.equal(66.67);
    expect(lessons[1].status).to.equal("AVAILABLE");
  });
}
