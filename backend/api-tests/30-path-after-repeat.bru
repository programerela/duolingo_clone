meta {
  name: 30 Path After Repeat
  type: http
  seq: 30
}
get {
  url: {{baseUrl}}/api/v1/courses/{{spanishCourseId}}/path
  body: none
  auth: bearer
}
auth:bearer {
  token: {{accessToken}}
}
tests {
  test("repeat increments completionCount without losing progress", function () {
    const lessons=res.body.sections.flatMap(s=>s.units.flatMap(u=>u.lessons));
    expect(lessons[0].completionCount).to.equal(2);
    expect(lessons[0].bestAccuracy).to.equal(100);
    expect(lessons[1].status).to.equal("COMPLETED");
    expect(lessons[2].status).to.equal("AVAILABLE");
  });
}
